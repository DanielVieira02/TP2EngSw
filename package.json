{
  "name": "relatorio-de-cities",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "build": "npm run purge && tsc --noEmit && npm run bundle",
    "bundle": "esbuild index.ts --bundle --platform=node --format=esm --packages=external --outfile=index.js",
    "start": "node index.js",
    "clean": "rm -rf index.js dist",
    "purge": "npm run clean && rm -rf reports"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/yargs": "^17.0.35",
    "csv-parse": "^7.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "yargs": "^17.7.2"
  }
}
